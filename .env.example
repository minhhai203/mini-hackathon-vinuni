# App settings
APP_APP_NAME="Mini Hackathon VinUni"
APP_APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"

# Optional LLM/API settings for future integration.
# Keep real keys in .env only. Do not commit secrets.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL=""
OPENAI_MAX_OUTPUT_TOKENS="450"
LLM_ENABLED="true"
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_MODEL=""
# ── LLM Provider ────────────────────────────────────────────────────────────
# Choose one: google | openai | local
LLM_PROVIDER=google

# ── Google Gemini ────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Local (Ollama / LM Studio / vLLM) ────────────────────────────────────────
# Ollama default:    http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=no-key

# ── Agent crawler settings ───────────────────────────────────────────────────
VINPEARL_CRAWLER_TIMEOUT_SECONDS="90"
VINPEARL_CRAWLER_MAX_MARKDOWN_CHARS="6000"
VINPEARL_CRAWL_CACHE_DIR="data/raw/vinpearl"

# ── Next.js frontend ─────────────────────────────────────────────────────────
BACKEND_URL="http://127.0.0.1:8000"
