# App settings
APP_APP_NAME="Mini Hackathon VinUni"
APP_APP_VERSION="0.1.0"
APP_ENVIRONMENT="development"

# Optional LLM/API settings for future integration.
# Keep real keys in .env only. Do not commit secrets.
OPENAI_API_KEY=""
OPENAI_MODEL=""
LOCAL_LLM_BASE_URL=""
LOCAL_LLM_MODEL=""

# Agent crawler settings
VINPEARL_CRAWLER_TIMEOUT_SECONDS="30"
VINPEARL_CRAWLER_MAX_MARKDOWN_CHARS="6000"
VINPEARL_CRAWL_CACHE_DIR="data/raw/vinpearl"

# Next.js frontend
BACKEND_URL="http://127.0.0.1:8000"
